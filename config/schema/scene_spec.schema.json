{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-foundry.local/schema/scene-spec-1.0.json",
  "title": "SceneSpec 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "seed", "units", "axes", "bounds", "source", "surfaces", "paths", "objects", "groups", "spawn", "camera"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483646 },
    "units": { "const": "studs" },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["up", "forward"],
      "properties": {
        "up": { "const": "Y" },
        "forward": { "const": "-Z" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "max_height"],
      "properties": {
        "width": { "type": "number", "minimum": 20, "maximum": 500 },
        "depth": { "type": "number", "minimum": 20, "maximum": 500 },
        "max_height": { "type": "number", "minimum": 5, "maximum": 150 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "scale_confidence", "assumptions"],
      "properties": {
        "summary": { "type": "string", "maxLength": 500 },
        "scale_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "assumptions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 180 } }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/surface" }
    },
    "paths": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/path" }
    },
    "objects": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/object" }
    },
    "groups": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/group" }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation_y"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "rotation_y": { "type": "number", "minimum": -360, "maximum": 360 }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "target", "fov"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "target": { "$ref": "#/$defs/vector3" },
        "fov": { "type": "number", "minimum": 25, "maximum": 90 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64 },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": -500, "maximum": 500 }
    },
    "vector2Positive": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 }
    },
    "nullableId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "material": {
      "type": "string",
      "enum": ["grass", "earth", "sand", "water", "stone", "concrete", "path", "wood", "dark_wood", "metal", "foliage", "foliage_light", "bark", "roof", "white", "glass"]
    },
    "nullableNumber": {
      "anyOf": [
        { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        { "type": "null" }
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "height", "roof_height", "wall_thickness", "door_width", "door_height", "trunk_height", "trunk_diameter", "canopy_radius", "radius", "length", "post_spacing", "material", "roof_material", "roof_style"],
      "properties": {
        "width": { "$ref": "#/$defs/nullableNumber" },
        "depth": { "$ref": "#/$defs/nullableNumber" },
        "height": { "$ref": "#/$defs/nullableNumber" },
        "roof_height": { "$ref": "#/$defs/nullableNumber" },
        "wall_thickness": { "$ref": "#/$defs/nullableNumber" },
        "door_width": { "$ref": "#/$defs/nullableNumber" },
        "door_height": { "$ref": "#/$defs/nullableNumber" },
        "trunk_height": { "$ref": "#/$defs/nullableNumber" },
        "trunk_diameter": { "$ref": "#/$defs/nullableNumber" },
        "canopy_radius": { "$ref": "#/$defs/nullableNumber" },
        "radius": { "$ref": "#/$defs/nullableNumber" },
        "length": { "$ref": "#/$defs/nullableNumber" },
        "post_spacing": { "$ref": "#/$defs/nullableNumber" },
        "material": { "anyOf": [{ "$ref": "#/$defs/material" }, { "type": "null" }] },
        "roof_material": { "anyOf": [{ "$ref": "#/$defs/material" }, { "type": "null" }] },
        "roof_style": { "enum": ["gable", "flat", null] }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "center", "size", "elevation", "thickness", "rotation_y", "material"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["ground", "platform", "water"] },
        "center": { "$ref": "#/$defs/vector3" },
        "size": { "$ref": "#/$defs/vector2Positive" },
        "elevation": { "type": "number", "minimum": -50, "maximum": 150 },
        "thickness": { "type": "number", "minimum": 0.05, "maximum": 20 },
        "rotation_y": { "type": "number", "minimum": -360, "maximum": 360 },
        "material": { "$ref": "#/$defs/material" }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "points", "width", "material", "surface_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "points": { "type": "array", "minItems": 2, "maxItems": 30, "items": { "$ref": "#/$defs/vector3" } },
        "width": { "type": "number", "minimum": 2, "maximum": 30 },
        "material": { "$ref": "#/$defs/material" },
        "surface_id": { "$ref": "#/$defs/nullableId" }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "position", "rotation_y", "scale", "surface_id", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["tree", "bush", "rock", "bench", "fence", "building"] },
        "position": { "$ref": "#/$defs/vector3" },
        "rotation_y": { "type": "number", "minimum": -360, "maximum": 360 },
        "scale": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
        },
        "surface_id": { "$ref": "#/$defs/nullableId" },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object_type", "distribution", "count", "area_center", "area_size", "scale_range", "surface_id", "path_id", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "object_type": { "enum": ["tree", "bush", "rock"] },
        "distribution": { "enum": ["scatter", "grid", "along_path"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 200 },
        "area_center": { "$ref": "#/$defs/vector3" },
        "area_size": { "$ref": "#/$defs/vector2Positive" },
        "scale_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "exclusiveMinimum": 0.2, "maximum": 3 }
        },
        "surface_id": { "$ref": "#/$defs/nullableId" },
        "path_id": { "$ref": "#/$defs/nullableId" },
        "params": { "$ref": "#/$defs/params" }
      }
    }
  }
}
