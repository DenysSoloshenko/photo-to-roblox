{
  "title": "SceneSpec 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "seed", "units", "axes", "bounds", "source", "surfaces", "paths", "objects", "groups", "spawn", "camera"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "name": { "type": "string" },
    "seed": { "type": "integer" },
    "units": { "type": "string", "enum": ["studs"] },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["up", "forward"],
      "properties": {
        "up": { "type": "string", "enum": ["Y"] },
        "forward": { "type": "string", "enum": ["-Z"] }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "max_height"],
      "properties": {
        "width": { "type": "number" },
        "depth": { "type": "number" },
        "max_height": { "type": "number" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "scale_confidence", "assumptions"],
      "properties": {
        "summary": { "type": "string" },
        "scale_confidence": { "type": "number" },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface" }
    },
    "paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" }
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/object" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation_y"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "rotation_y": { "type": "number" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "target", "fov"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "target": { "$ref": "#/$defs/vector3" },
        "fov": { "type": "number" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string" },
    "vector3": {
      "type": "array",
      "items": { "type": "number" }
    },
    "vector2Positive": {
      "type": "array",
      "items": { "type": "number" }
    },
    "nullableId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "material": {
      "type": "string",
      "enum": ["grass", "earth", "sand", "water", "stone", "concrete", "path", "wood", "dark_wood", "metal", "foliage", "foliage_light", "evergreen", "flower_mix", "flower_red", "flower_orange", "flower_pink", "flower_yellow", "flower_purple", "flower_white", "mountain", "bark", "roof", "white", "glass"]
    },
    "nullableNumber": {
      "anyOf": [
        { "type": "number" },
        { "type": "null" }
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "height", "roof_height", "wall_thickness", "door_width", "door_height", "trunk_height", "trunk_diameter", "canopy_radius", "radius", "length", "post_spacing", "material", "roof_material", "roof_style"],
      "properties": {
        "width": { "$ref": "#/$defs/nullableNumber" },
        "depth": { "$ref": "#/$defs/nullableNumber" },
        "height": { "$ref": "#/$defs/nullableNumber" },
        "roof_height": { "$ref": "#/$defs/nullableNumber" },
        "wall_thickness": { "$ref": "#/$defs/nullableNumber" },
        "door_width": { "$ref": "#/$defs/nullableNumber" },
        "door_height": { "$ref": "#/$defs/nullableNumber" },
        "trunk_height": { "$ref": "#/$defs/nullableNumber" },
        "trunk_diameter": { "$ref": "#/$defs/nullableNumber" },
        "canopy_radius": { "$ref": "#/$defs/nullableNumber" },
        "radius": { "$ref": "#/$defs/nullableNumber" },
        "length": { "$ref": "#/$defs/nullableNumber" },
        "post_spacing": { "$ref": "#/$defs/nullableNumber" },
        "material": { "anyOf": [{ "$ref": "#/$defs/material" }, { "type": "null" }] },
        "roof_material": { "anyOf": [{ "$ref": "#/$defs/material" }, { "type": "null" }] },
        "roof_style": { "anyOf": [{ "type": "string", "enum": ["gable", "flat"] }, { "type": "null" }] }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "center", "size", "elevation", "thickness", "rotation_y", "material"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "enum": ["ground", "platform", "ellipse", "water"] },
        "center": { "$ref": "#/$defs/vector3" },
        "size": { "$ref": "#/$defs/vector2Positive" },
        "elevation": { "type": "number" },
        "thickness": { "type": "number" },
        "rotation_y": { "type": "number" },
        "material": { "$ref": "#/$defs/material" }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "points", "width", "material", "surface_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/vector3" } },
        "width": { "type": "number" },
        "material": { "$ref": "#/$defs/material" },
        "surface_id": { "$ref": "#/$defs/nullableId" }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "position", "rotation_y", "scale", "surface_id", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["tree", "bush", "flower", "hedge", "conifer", "arch", "mountain", "rock", "bench", "fence", "building"] },
        "position": { "$ref": "#/$defs/vector3" },
        "rotation_y": { "type": "number" },
        "scale": {
          "type": "array",
          "items": { "type": "number" }
        },
        "surface_id": { "$ref": "#/$defs/nullableId" },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object_type", "distribution", "count", "area_center", "area_size", "scale_range", "surface_id", "path_id", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "object_type": { "type": "string", "enum": ["tree", "bush", "flower", "hedge", "conifer", "rock"] },
        "distribution": { "type": "string", "enum": ["scatter", "grid", "along_path", "frame"] },
        "count": { "type": "integer" },
        "area_center": { "$ref": "#/$defs/vector3" },
        "area_size": { "$ref": "#/$defs/vector2Positive" },
        "scale_range": {
          "type": "array",
          "items": { "type": "number" }
        },
        "surface_id": { "$ref": "#/$defs/nullableId" },
        "path_id": { "$ref": "#/$defs/nullableId" },
        "params": { "$ref": "#/$defs/params" }
      }
    }
  }
}
