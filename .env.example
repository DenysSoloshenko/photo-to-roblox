# Server-side only. Never put this value into frontend/Vite variables.
OPENAI_API_KEY=

# Balanced default. Use gpt-5.6-luna for the lower-cost prototype path.
VISION_MODEL=gpt-5.6-terra
# Optional for reasoning models: low, medium, high, xhigh, or max.
VISION_REASONING_EFFORT=
# High-reasoning requests can exceed two minutes.
VISION_READ_TIMEOUT_SECONDS=600
# Astra High may need room for reasoning plus the complete structured scene.
VISION_MAX_OUTPUT_TOKENS=24000
