# Server-side only. Never put this value into frontend/Vite variables.
OPENAI_API_KEY=

# Strong default with a cheaper second composition-review pass.
VISION_MODEL=gpt-5.6-terra
# Supported API values: none, low, medium, high, xhigh, or max.
VISION_REASONING_EFFORT=high
VISION_REFINEMENT_ENABLED=true
VISION_REFINEMENT_REASONING_EFFORT=medium
# High-reasoning requests can take several minutes.
VISION_READ_TIMEOUT_SECONDS=300
VISION_MAX_OUTPUT_TOKENS=10000

# Premium opt-in profile: gpt-6-astra max draft + high-reasoning review.
# Keep disabled on public deployments until authentication, quotas, and spend limits are configured.
ASTRA_QUALITY_ENABLED=false
ASTRA_REFINEMENT_REASONING_EFFORT=high
ASTRA_READ_TIMEOUT_SECONDS=1200
ASTRA_MAX_OUTPUT_TOKENS=48000
# Customer orders are always fulfilled manually. These runner limits are retained
# only for explicit developer experiments outside the customer order workflow.
ASTRA_ORDER_AUTOMATION_ENABLED=false
ASTRA_ORDER_MAX_CONCURRENT=1
ASTRA_ORDER_DAILY_SPEND_LIMIT_USD=30
# Conservative amount reserved against the daily ceiling before actual usage is known.
ASTRA_ORDER_COST_RESERVATION_USD=3

# Public URLs used by OAuth callbacks and notification emails.
APP_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3000
APP_HOST=127.0.0.1
APP_PORT=5173

# PostgreSQL stores accounts, orders, payment state, notifications, and preview geometry.
# Leave POSTGRES_HOST blank for the local Unix socket used by Homebrew PostgreSQL.
POSTGRES_DB=photo_to_roblox_development
POSTGRES_TEST_DB=photo_to_roblox_test
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
# Production should set one managed PostgreSQL URL instead of the variables above.
DATABASE_URL=

# Comma-separated operator accounts. Every new order is emailed to these
# addresses, and matching accounts can access the admin Orders workspace.
ADMIN_EMAILS=you@example.com

# Google is the only social login. Leave blank to keep the button visible with
# setup guidance while email/password authentication remains available.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Checkout. Use test-mode keys locally. The webhook secret is produced by
# `stripe listen --forward-to 127.0.0.1:3000/api/v1/payments/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP is optional in development: messages are written to tmp/mails without it.
# New-order, password-reset, preview-ready, and map-ready templates can always
# be previewed by an admin.
MAIL_FROM=SceneFoundry <orders@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Binary uploads stay outside PostgreSQL. Use local disk now and switch this one
# value to amazon after configuring the private S3 bucket below.
ACTIVE_STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
S3_BUCKET=
